# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — must be from a domain verified in Resend
# Use "Resend Onboarding <onboarding@resend.dev>" for testing before domain setup
FROM_EMAIL=portfolio@nandan.dev

# URL mode and canonical origins
# Local:
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_BLOG_ORIGIN=http://localhost:3000/blog

# Production:
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_SITE_ORIGIN=https://nandankumar.com
# NEXT_PUBLIC_BLOG_ORIGIN=https://blog.nandankumar.com

# Blog/comment database
DATABASE_URL=postgresql://user:password@localhost:5433/portfolio

# Comments
COMMENTS_ENABLED=true
IP_SALT=reserved-for-future-hashing

# Admin owner session
# Generate with: npx tsx scripts/hash-admin-password.ts "your-password"
ADMIN_PASSWORD_HASH=scrypt:salt:hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Dedicated comments Telegram bot (must be separate from Hermes)
COMMENTS_TG_BOT_TOKEN=
COMMENTS_TG_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Turnstile CAPTCHA
# Create a widget at https://dash.cloudflare.com → Turnstile for your domain.
# The test keys below always pass — use them for local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
